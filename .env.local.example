NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role (secret) key — required by createSystemUser() in
# src/lib/supabase/queries.ts, which uses the Supabase Admin API to
# provision real login-capable accounts from the Manage Users screen.
# NEVER expose this to the browser; it bypasses Row Level Security.
# Get it from Supabase Studio -> Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=
